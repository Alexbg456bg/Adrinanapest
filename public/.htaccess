# Адрина ООД — Apache (cPanel) настройки за статичния сайт.

# Стари адреси от предишния сайт (WordPress + статични .html страници) —
# 301 към новия сайт, за да не дават 404 и Google да прехвърли стария индекс.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} ^[A-Z]+[[:space:]]/(%d0%ba%d0%be%d0%bd%d1%82%d0%b0%d0%ba%d1%82%d0%b8|contacts(_sent)?([.]html)?)/?([?][^[:space:]]*)?[[:space:]]HTTP [NC]
  RewriteRule ^ https://adrinapest.com/#kontakti [R=301,L,NE,QSD]
  RewriteCond %{THE_REQUEST} ^[A-Z]+[[:space:]]/(%d0%b4%d0%b5%d0%b7%d0%b8%d0%bd%d1%81%d0%b5%d0%ba%d1%86%d0%b8%d1%8f|%d0%b4%d0%b5%d0%b7%d0%b8%d0%bd%d1%84%d0%b5%d0%ba%d1%86%d0%b8%d1%8f|%d0%b4%d0%b5%d1%80%d0%b0%d1%82%d0%b8%d0%b7%d0%b0%d1%86%d0%b8%d1%8f|%d0%b4%d0%b5%d0%b7%d0%b0%d0%ba%d0%b0%d1%80%d0%b8%d0%b7%d0%b0%d1%86%d0%b8%d1%8f|%d0%b7%d0%b0-%d0%bd%d0%b0%d1%81|%d0%b3%d0%b0%d0%bb%d0%b5%d1%80%d0%b8%d1%8f|%d0%b2%d1%80%d1%8a%d0%b7%d0%ba%d0%b8|%d0%bd%d0%b0%d1%87%d0%b0%d0%bb%d0%be|%d1%84%d0%be%d1%80%d0%bc%d0%b0-%d0%b7%d0%b0-%d0%ba%d0%be%d0%bd%d1%82%d0%b0%d0%ba%d1%82%d0%b8-1|hello-world|flash|flash-child|price([.]html)?|dezinf([.]html)?|about([.]html)?|deratiz([.]html)?|partners([.]html)?|dezakar([.]html)?|dezins([.]html)?|index-old-website([.]html)?|new|index.php)/?([?][^[:space:]]*)?[[:space:]]HTTP [NC]
  RewriteRule ^ https://adrinapest.com/ [R=301,L,QSD]
  # Стари WordPress адреси от вида /?p=12, /?page_id=5, /?s=...
  RewriteCond %{QUERY_STRING} ^(p|page_id|cat|s|m|tag|attachment_id)=
  RewriteRule ^$ https://adrinapest.com/ [R=301,L,QSD]
</IfModule>

# Един адрес за сайта: https://adrinapest.com (без www, винаги през HTTPS).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Файловете в /assets/ имат хеш в името — безопасно е да се кешират за дълго.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
